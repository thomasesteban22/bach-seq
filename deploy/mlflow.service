# Servidor MLflow (tracking + registry + artefactos servidos por HTTP), sin autenticacion.
# Copiar a /etc/systemd/system/mlflow.service
[Unit]
Description=MLflow Tracking Server (bach)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mlflow-server
ExecStart=/home/ubuntu/bach-seq/.venv/bin/mlflow server \
    --host 0.0.0.0 --port 5000 --workers 2 \
    --backend-store-uri sqlite:////home/ubuntu/mlflow-server/mlflow.db \
    --artifacts-destination /home/ubuntu/mlflow-server/mlartifacts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
